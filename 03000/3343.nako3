//コンテナ
『<div id="canvas-container" style="position:relative; margin-left:60px;">
    <canvas id="baseCanvas" style="border: 1px dotted silver;"></canvas>
    <canvas id="work1Canvas" style="position:absolute; left:0; top:0;border: 1px dotted silver;"></canvas>
    <canvas id="work2Canvas" style="position:absolute; left:0; top:0;border: 1px dotted silver;"></canvas>
