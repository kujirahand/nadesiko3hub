    WEBKIT_DIR = Path("nadesiko3webkit.git")
else:
    WEBKIT_DIR = Path("nadesiko3webkit")

# init時に main.nako3 へ施す修正（1始まりの行番号）
COMMENT_LINES = (127, 128, 129, 130, 131, 132, 133)
DELETE_LINES = (5,)

