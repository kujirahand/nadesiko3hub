# --- 星が輝く中の月と地球 ---
CX = 150
CY = 150
ER = 60 # 地球の半径
T = 0
PI = 3.14159265

# --- 変数名を「星数」に修正！星のサイズも極小化 ---
星数 = 60 # 星が小さくなるので、数を少し増やして天然の満天の星空にします
星リストX = []
星リストY = []
星リストS = [] # 星の大きさ

星数 回、
    星リストXに(300の乱数)を追加
    星リストYに(300の乱数)を追加
    
    # 【ここを大改造】大部分をピンホールのような極小サイズにします
    もし、(10の乱数) < 2 ならば
        # 2割の確率で、ほんの少しだけ見えやすい星（半径1.2）
        星リストSに(1.2)を追加
    違えば
        # 8割の確率で、肉眼でやっと見えるレベルの極小の星（半径0.5〜0.9）
        星リストSに(0.5 + 0.4の乱数)を追加
    ここまで
ここまで

# 0.02秒ごとに「描画ループ」を滑らかに実行します
「描画ループ」を0.02秒毎。

●描画ループとは
    # 1. 宇宙のベース（濃い紺色）
    「#000015」に塗色設定
    「#000015」に線色設定
    [0, 0, 300, 300]へ四角描画
    
    # 2. 幻想的な星雲（ネビュラ）を描画
    「rgba(0,0,0,0)」に線色設定
    # 右上の紫色の星雲
    25回、
        NEB_R = 30 + 回数 * 4
        「rgba(100, 30, 160, 0.02)」に塗色設定
        [230, 70]へNEB_Rの円描画
    ここまで
    # 左下の青緑色の星雲
    20回、
        NEB_R = 40 + 回数 * 5
        「rgba(0, 60, 120, 0.02)」に塗色設定
        [60, 240]へNEB_Rの円描画
    ここまで
    
    # 3. リアルになった遠くの星たちを描画
    星数 回、
        I = 回数 - 1
        # 小さくなった星に合わせて、またたきの光も繊細に調整
        ALPHA = 0.2 + (50の乱数 / 100)
        「rgba(255,255,255,{ALPHA})」に塗色設定
        [星リストX[I], 星リストY[I]]へ星リストS[I]の円描画
    ここまで
    
    # 角度を更新
    T = T + 1
    もしT >= 360 ならば、T = 0
    RAD = T * PI / 180
    MX = CX + 120 * (RADのCOS)
    MY = CY + 30 * (RADのSIN)
    
    # 月が地球の裏側にある場合
    もし(RADのSIN) < 0 ならば
        極上月描画(MX, MY, 12)
    ここまで
    
    # 青が満ちあふれるリアル地球を描きます
    極上地球描画(CX, CY, ER)
    
    # 月が地球の手前にある場合
    もし(RADのSIN) >= 0 ならば
        極上月描画(MX, MY, 12)
    ここまで
ここまで。

●極上地球描画(X, Y, R)とは
    「rgba(0,0,0,0)」に線色設定
    「rgba(0, 120, 255, 0.12)」に塗色設定
    [X, Y]へ(R + 6)の円描画
    「rgba(0, 150, 255, 0.06)」に塗色設定
    [X, Y]へ(R + 12)の円描画
    
    50回、
        もし、回数 <= 40 ならば
            K = 回数 / 40
            R_VAL = 0
            G_VAL = (60 + 110 * K)を整数変換
            B_VAL = (120 + 135 * K)を整数変換
            R_RATIO = 1.0 - (K * 0.65)
            OFFSET = 18 * K
        違えば
            K = (回数 - 40) / 10
            K2 = K * K 
            R_VAL = (255 * K2)を整数変換
            G_VAL = (170 + 85 * K2)を整数変換
            B_VAL = 255
            R_RATIO = 0.35 - (K * 0.32)
            OFFSET = 18 + 6 * K
        ここまで
        
        CUR_R = R * R_RATIO
        CUR_X = X - OFFSET
        CUR_Y = Y - OFFSET
        
        もし、回数 <= 3 ならば
            ALPHA = 0.2 + (回数 / 3) * 0.8
            COLOR = 「rgba({R_VAL},{G_VAL},{B_VAL},{ALPHA})」
        違えば
            COLOR = 「rgb({R_VAL},{G_VAL},{B_VAL})」
        ここまで
        
        COLORに塗色設定
        [CUR_X, CUR_Y]へCUR_Rの円描画
    ここまで
ここまで。

●極上月描画(X, Y, R)とは
    「rgba(0,0,0,0)」に線色設定
    15回、
        もし、回数 <= 12 ならば
            K = 回数 / 12
            R_VAL = (90 + 165 * K)を整数変換
            G_VAL = (60 + 185 * K)を整数変換
            B_VAL = (10 + 40 * K)を整数変換
            R_RATIO = 1.0 - (K * 0.65)
            OFFSET = 3.6 * K
        違えば
            K = (回数 - 12) / 3
            K2 = K * K
            R_VAL = 255
            G_VAL = 255
            B_VAL = (50 + 205 * K2)を整数変換
            R_RATIO = 0.35 - (K * 0.32)
            OFFSET = 3.6 + 1.2 * K
        ここまで
        
        CUR_R = R * R_RATIO
        CUR_X = X - OFFSET
        CUR_Y = Y - OFFSET
        
        もし、回数 <= 2 ならば
            ALPHA = 0.3 + (回数 / 2) * 0.7
            COLOR = 「rgba({R_VAL},{G_VAL},{B_VAL},{ALPHA})」
        違えば
            COLOR = 「rgb({R_VAL},{G_VAL},{B_VAL})」
        ここまで
        
        COLORに塗色設定
        [CUR_X, CUR_Y]へCUR_Rの円描画
    ここまで
ここまで。