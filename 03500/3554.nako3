# 「LocalServerManager.swift」ファイルのコード
LOCAL_SERVER_MANAGER_SWIFT = r'''import Foundation
import Network
import UniformTypeIdentifiers

class LocalServerManager {
    private var listener: NWListener?

    func startServer() {
        let port = NWEndpoint.Port(integerLiteral: 8080)
        do {
            let params = NWParameters.tcp
            params.requiredInterfaceType = .loopback // 端末内（localhost）からの接続だけ受け付ける
            let listener = try NWListener(using: params, on: port)
            self.listener = listener

            listener.newConnectionHandler = { connection in
                connection.start(queue: .main)
                connection.receive(minimumIncompleteLength: 1, maximumLength: 65536) { data, _, isComplete, error in
                    if let data = data, !data.isEmpty, let requestString = String(data: data, encoding: .utf8) {

                        let firstLine = requestString.components(separatedBy: "\r\n").first ?? ""
                        let components = firstLine.components(separatedBy: " ")

                        guard components.count >= 2, components[0] == "GET" else {
                            self.send404(to: connection)
                            return
                        }
                        
                        var requestPath = components[1]
                        if requestPath == "/" {
                            requestPath = "/index.html"
                        }
                        
                        // 💡 改善点：URL型に変換してクエリパラメータなどを除外
                        guard let urlComponents = URLComponents(string: requestPath) else {
                            self.send404(to: connection)
                            return
                        }
                        let cleanPath = urlComponents.path // 例: "/js/core.js"

                        // サブディレクトリのパス、ファイル名、拡張子を正しく分解する
                        let fileURL = URL(fileURLWithPath: cleanPath)
                        let fileName = fileURL.deletingPathExtension().lastPathComponent // "core"
                        let fileExtension = fileURL.pathExtension // "js"

                        // 💡 改善点：nako3 フォルダをベースのディレクトリとして設定する
                        var subDirectory = "nako3" 

                        let directoryPath = fileURL.deletingLastPathComponent().path // 例: "/js"
                        if directoryPath != "/" && !directoryPath.isEmpty {
                            // 先頭の "/" を除いた階層パス（例: "js"）を "nako3" の後ろに結合する
                            let relativePath = String(directoryPath.dropFirst())
                            subDirectory += "/\(relativePath)" // 結果: "nako3/js"
                        }

                        // 💡 アプリ内（Bundle）から自動補完されたサブディレクトリを指定して検索
                        var resourceURL = Bundle.main.url(forResource: fileName, withExtension: fileExtension, subdirectory: subDirectory)
                        if resourceURL == nil {
                            resourceURL = Bundle(for: type(of: self)).url(forResource: fileName, withExtension: fileExtension, subdirectory: subDirectory)
                        }

                        if let targetURL = resourceURL, let fileData = try? Data(contentsOf: targetURL) {
                            var contentType = "application/octet-stream" // デフォルトのバイナリ
                            if let utType = UTType(filenameExtension: fileExtension) {
                                contentType = utType.preferredMIMEType ?? contentType
                            }

                            let headerString = "HTTP/1.1 200 OK\r\n" +
                                               "Content-Type: \(contentType)\r\n" +
                                               "Content-Length: \(fileData.count)\r\n" +
                                               "Access-Control-Allow-Origin: *\r\n" + 
                                               "Connection: close\r\n\r\n"

                            if let headerData = headerString.data(using: .utf8) {
                                var responseData = headerData
                                responseData.append(fileData)
                                connection.send(content: responseData, completion: .contentProcessed({ _ in
                                    connection.cancel()
                                }))
                            }
                        } else {
                            self.sendFallbackHTML(to: connection)
                        }
                    }
                }
            }

            listener.start(queue: .main)
            print("サーバーが起動しました！ブラウザで http://localhost:8080 を開いてください。")
        } catch {
            print("サーバーの起動に失敗しました: \(error)")
        }
    }

    private func send404(to connection: NWConnection) {
        let body = "<h1>404 Not Found</h1><p>要求されたファイルが見つかりません。</p>"
        let bodyData = body.data(using: .utf8) ?? Data()
        
        let headerString = "HTTP/1.1 404 Not Found\r\n" +
                           "Content-Type: text/html; charset=utf-8\r\n" +
                           "Content-Length: \(bodyData.count)\r\n" +
                           "Connection: close\r\n\r\n"

        if let headerData = headerString.data(using: .utf8) {
            var responseData = headerData
            responseData.append(bodyData)
            connection.send(content: responseData, completion: .contentProcessed({ _ in
                connection.cancel()
            }))
        }
    }

    private func sendFallbackHTML(to connection: NWConnection) {
        let html = """
        <!DOCTYPE html>
        <html>
        <head><meta charset="utf-8"><title>Swift Server</title></head>
        <body>
        <h1>サーバーは正常に動作しています！</h1>
        <p>ただし、指定されたHTMLファイルが読み込めなかったため、この仮ページを表示しています。</p>
        </body>
        </html>
        """

        if let bodyData = html.data(using: .utf8) {
            let headerString = "HTTP/1.1 200 OK\r\n" +
                               "Content-Type: text/html; charset=utf-8\r\n" +
                               "Content-Length: \(bodyData.count)\r\n" +
                               "Connection: close\r\n\r\n"

            if let headerData = headerString.data(using: .utf8) {
                var responseData = headerData
                responseData.append(bodyData)
                connection.send(content: responseData, completion: .contentProcessed({ _ in
                    connection.cancel()
                }))
            }
        }
    }
}'''

# init時に生成するSwiftファイル（ファイル名 -> 内容）
SWIFT_FILES = {
    "ContentView.swift": CONTENT_VIEW_SWIFT,
    "MyApp.swift": MY_APP_SWIFT,
    "Package.swift": PACKAGE_SWIFT,
    "LocalServerManager.swift": LOCAL_SERVER_MANAGER_SWIFT,
}

USAGE = """\
nako3swiftpm - Swift Playgroundsで日本語プログラミングなでしこ３が実行可能な
               swiftpmファイルを作成するツール

[使い方]
 nako3swiftpm init    <swiftpmファイル>  実行可能なswiftpmファイルを新規作成
 nako3swiftpm upgrade <swiftpmファイル>  なでしこ３を最新版にアップグレード
 nako3swiftpm add     <swiftpmファイル> <追加フォルダ or 追加ファイル>
                                         指定のフォルダ以下のファイルを追加
                                         または、指定のファイルを追加
                                         <<制限事項>>
                                         iPadのターミナルアプリで追加フォルダ
                                         やファイルを指定する際は、「../」を
                                         使用しないでください。誤作動の原因と
                                         なります。
 nako3swiftpm version                    バージョン情報を表示

[用意するファイル(initは新規作成のため必要なし)]
 nako3swiftpm upgrade : init実行後のSwift Playgroundsで編集中のswiftpmファイル
 nako3swiftpm add     : init実行後のSwift Playgroundsで編集中のswiftpmファイル"""


class ToolError(Exception):
    """利用者に表示して中止するエラー"""

# -----------------------------------------------------------------------------
# ユーティリティ
# -----------------------------------------------------------------------------
def http_get(url: str, timeout: float = 60) -> bytes:
    req = urllib.request.Request(
        url, headers={"User-Agent": f"nako3swiftpm/{NAKO3SWIFTPM_VERSION}"}
    )
    with urllib.request.urlopen(req, timeout=timeout) as res:
        return res.read()


def write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w", encoding="utf-8", newline="\n") as f:
        f.write(text)


def remove_path(path: Path) -> None:
    """ファイルまたはフォルダを（存在すれば）削除する"""
    if path.is_dir() and not path.is_symlink():
        shutil.rmtree(path, ignore_errors=True)
    elif path.exists() or path.is_symlink():
        path.unlink(missing_ok=True)

def copy_licenses(src_dir: Path, dest_dir: Path, label: str) -> bool:
    """src_dir 直下のライセンス関連ファイルを dest_dir に「label-元のファイル名」でコピーする。
    1件以上コピーしたら True を返す。"""
    copied = False
    if not src_dir.is_dir():
        return False
    for p in sorted(src_dir.iterdir()):
        if p.is_file() and p.name.upper().startswith(("LICENSE", "LICENCE", "COPYING", "NOTICE")):
            dest_dir.mkdir(parents=True, exist_ok=True)
            shutil.copy2(p, dest_dir / f"{label}-{p.name}")
            copied = True
    return copied

# -----------------------------------------------------------------------------
# 各処理
# -----------------------------------------------------------------------------
def add_resource(resource_dir: Path, target: str) -> None:
    """リソースフォルダに追加ファイル（またはフォルダ内のファイル）を上書きコピーする"""
    sub_path = target.split("/", 1)
    if len(sub_path) > 1:
        sub_path = sub_path[1]
    else:
        sub_path = ""
    dest = resource_dir / WEBAPP.lstrip("/") / Path(sub_path)
    src = Path(target)
    if src.is_dir():
        # フォルダ以下のファイルをそのままリソース直下へ追加する
        print(f"[add] {src}/* -> {dest}/*")    
        shutil.copytree(src, dest, dirs_exist_ok=True)
    elif src.exists():
        if sub_path == "":
            dest = dest / src.name
        print(f"[add] {src} -> {dest}")    
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dest)
    else:
        raise ToolError(f"追加するファイルまたはフォルダ({target})が存在しない")


def patch_main_nako3(path: Path) -> None:
    """main.nako3 の指定行をコメントアウト／削除する"""
    if not path.exists():
        raise ToolError(f"{path} が見つかりません。")
    lines = path.read_text(encoding="utf-8").split("\n")
    if len(lines) < max(COMMENT_LINES):
        print(
            f"警告: {path.name} の行数が想定より少ないため、一部の行を処理できません。",
            file=sys.stderr,
        )
    for n in COMMENT_LINES:
        if 1 <= n <= len(lines):
            lines[n - 1] = "#" + lines[n - 1]
    for n in sorted(DELETE_LINES, reverse=True):
        if 1 <= n <= len(lines):
            del lines[n - 1]
    write_text(path, "\n".join(lines))


def build(action: str, swiftpm: Path, work: list[Path]) -> None:
    """最新のなでしこ3をダウンロードして init / upgrade を実行する。
    作成した作業ファイルは work に追加していく（後で削除するため）。"""
    # 最新のなでしこ3バージョンを取得して、ダウンロードするファイル名(拡張子なし)を作成
    nako_version = json.loads(http_get(NAKO_VERSION_URL).decode("utf-8"))
    download_nako = f"nadesiko3-{nako_version['version']}"
    tgz = Path(f"{download_nako}.tgz")
    extracted = Path(download_nako)

    print(f"{download_nako} をダウンロードしています...")
    data = http_get(NPM_TARBALL_URL.format(name=download_nako))

    # 保存処理
    work += [tgz, extracted]
    tgz.write_bytes(data)
    extracted.mkdir(exist_ok=True)
    with tarfile.open(tgz, "r:gz") as tf:
        safe_extract(tf, extracted)

    resource_dir = swiftpm / RESOURCES
    webapp_dir = resource_dir / WEBAPP.lstrip("/")

    if action == "init":
        if WEBKIT_DIR.exists():
            raise ToolError(
                f"作業用フォルダ({WEBKIT_DIR})が既に存在するため中止します。"
            )
        work.append(WEBKIT_DIR)
        try:
            subprocess.run(
                [GIT, "clone", WEBKIT_REPO],
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except FileNotFoundError:
            raise ToolError(f"{GIT} コマンドが見つかりません。") from None
        except subprocess.CalledProcessError as e:
            raise ToolError(f"{GIT} clone に失敗しました (終了コード {e.returncode})。") from e
        shutil.copytree(WEBKIT_DIR / "webapp", webapp_dir, dirs_exist_ok=True)
        if not copy_licenses(WEBKIT_DIR, webapp_dir, "nadesiko3webkit"):
            print("警告: nadesiko3webkit のライセンスファイルが見つかりませんでした。"
                  "配布前に元リポジトリのライセンスを確認してください。", file=sys.stderr)
        (swiftpm / "Resources").mkdir(exist_ok=True)

    if action in ("init", "upgrade"):
        shutil.copytree(
            extracted / "package" / "release",
            webapp_dir / "nadesiko3",
            dirs_exist_ok=True,
        )
        if not copy_licenses(extracted / "package", webapp_dir / "nadesiko3", "nadesiko3"):
            print("警告: なでしこ3のライセンスファイルが見つかりませんでした。"
                  "配布前に確認してください。", file=sys.stderr)

    if action == "init":
        # 「main.nako3」の指定の行をコメントと指定の行を削除にする
        patch_main_nako3(webapp_dir / "main.nako3")
        # Swiftファイルを作成
        for filename, text in SWIFT_FILES.items():
            write_text(swiftpm / filename, text)


def safe_extract(tf: tarfile.TarFile, dest: Path) -> None:
    """tar を安全に展開する（filter 引数が使えない古い Python にも対応）"""
    if hasattr(tarfile, "data_filter"):
        tf.extractall(dest, filter="data")
        return
    base = Path(dest).resolve()
    for m in tf.getmembers():
        target = (base / m.name).resolve()
        if target != base and base not in target.parents:
            raise ToolError(f"不正なパスを含むアーカイブです: {m.name}")
        if not (m.isfile() or m.isdir()):
            raise ToolError(f"未対応のエントリを含むアーカイブです: {m.name}")
    tf.extractall(dest)

# -----------------------------------------------------------------------------
# メイン
# -----------------------------------------------------------------------------
def main() -> int:
    params = sys.argv[1:]

    if len(params) <= 1:
        if params and params[0] == "version":
            os_name = platform.system().lower()
            arch = platform.machine().lower()
            print(f"nako3swiftpm {NAKO3SWIFTPM_VERSION} ({os_name}/{arch})")
        else:
            print(USAGE)
        return 0

    action = params[0]
    if action not in ("init", "upgrade", "add"):
        print(USAGE)
        return 1
    file = params[1].rstrip("/\\") or params[1]  # 終端パス除去

    # swiftpmファイル名を作成
    stem = os.path.splitext(file)[0]
    if os.path.splitext(stem)[1] != ".swiftpm":
        stem += ".swiftpm"
    swiftpm = Path(stem)

    try:
        if action == "init":
            # swiftpmファイルを作成
            if swiftpm.exists():
                print(f"既に{swiftpm}が存在するため中止します。")
                return 1
            swiftpm.mkdir(parents=True)
        elif not Path(file).exists():
            print(f"指定のファイル({file})が存在しません。")
            return 1
            
        if action != "init" and not swiftpm.is_dir():
            raise ToolError(f"{swiftpm} フォルダが見つかりません。")

        if action == "add":
            if len(params) == 3:
                # リソースフォルダにファイルを追加
                add_resource(swiftpm / RESOURCES, params[2])
            else:
                print(USAGE)
            return 0

        work: list[Path] = []
        try:
            build(action, swiftpm, work)
        finally:
            # 作業ファイルとフォルダを削除
            for p in work:
                remove_path(p)
        print("完了しました。")
        return 0

    except (ToolError, OSError, ValueError, KeyError, tarfile.TarError) as e:
        print(f"エラー: {e}", file=sys.stderr)
        if action == "init":
            remove_path(swiftpm)  # 途中まで作ったものを残さない
        return 1


if __name__ == "__main__":
    sys.exit(main())