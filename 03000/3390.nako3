// 変数の設定
Y = 200            // キャラクターのY座標
速度Y = 0          // 縦方向の移動速度
重力 = 0.8         // 60fps用の重力
地面Y = 200         // 地面の高さ
トゲX = 300        // トゲの初期位置
スピード = 4.5     // 60fps用のスクロール速度
ゲームオーバー = 0 // 0:プレイ中、1:ゲームオーバー
フレーム数 = 0     // 生存時間計測用

// メインループ（約60fpsで「画面更新」をずっと繰り返し実行）
0.016秒毎には
    画面更新
ここまで

// キーボードを押したときの処理
DOCUMENTをキー押した時には
    K = 押されたキー
    
    // スペースキーでジャンプ（プレイ中のみ）
    もし (K == " ")かつ(Y == 地面Y)かつ(ゲームオーバー == 0)ならば
        速度Y = -11.5
    ここまで
    
    // Rキーでリトライ（ゲームオーバー時）
    もし (ゲームオーバー == 1)かつ(K == "r" または K == "R")ならば
        Y = 地面Y
        速度Y = 0
        トゲX = 300
        フレーム数 = 0
        ゲームオーバー = 0
    ここまで
ここまで

// --- 画面更新処理（毎フレームずっと動く処理） ---
●画面更新とは
    描画クリア
    
    // 生存時間（秒）の計算
    秒数 = (フレーム数 / 60)の切り捨て
    
    // ■ ゲームオーバー画面の表示
    もし (ゲームオーバー == 1) ならば
        「#FF0000」に塗色設定
        [85, 80, "GAME OVER"]の文字描画
        
        「#000000」に塗色設定
        [70, 120, "生存時間: " & 秒数 & "秒"]の文字描画
        
        「#0000FF」に塗色設定
        [65, 160, "Rキーを押してリトライ"]の文字描画
        戻る
    ここまで

    // プレイ中の時間（フレーム）を加算
    フレーム数 = フレーム数 + 1

    // 1. 地面の描画
    「#888888」に塗色設定
    [0, 230, 300, 30]の四角描画

    // 2. 物理計算（重力と位置の更新）
    速度Y = 速度Y + 重力
    Y = Y + 速度Y
    もし (Y >= 地面Y)ならば
        Y = 地面Y
        速度Y = 0
    ここまで
    
    // 3. トゲの移動（左へスクロール）
    トゲX = トゲX - スピード
    もし (トゲX < -20)ならば
        トゲX = 320
    ここまで

    // 4. トゲとの当たり判定
    もし (トゲX < 165)かつ(トゲX + 20 > 135)かつ(Y + 15 >= 地面Y)ならば
        ゲームオーバー = 1
    ここまで

    // 5. トゲの描画（黒い三角）
    「#000000」に塗色設定
    [[トゲX, 230], [トゲX + 10, 200], [トゲX + 20, 230]]の多角形描画

    // 6. キャラクターの描画（赤い四角）
    「#FF4444」に塗色設定
    [135, Y, 30, 30]の四角描画

    // 7. 画面左上に現在のタイムを表示
    「#000000」に塗色設定
    [10, 25, "タイム: " & 秒数 & "秒"]の文字描画
ここまで