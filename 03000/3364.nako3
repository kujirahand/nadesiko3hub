# --- なでしこ3 W球体レイトレーシング風 ---
CX = 150
CY = 150
ER = 60 # 地球の半径
T = 0
PI = 3.14159265

# 0.02秒ごとに「描画ループ」を滑らかに実行します
「描画ループ」を0.02秒毎。

●描画ループとは
    # 宇宙的背景（濃い紺色）で画面全体を塗りつぶす
    「#000022」に塗色設定
    「#000022」に線色設定
    [0, 0, 300, 300]へ四角描画
    
    # 角度を更新
    T = T + 1
    もしT >= 360 ならば、T = 0
    
    # 度数法からラジアンに変換
    RAD = T * PI / 180
    
    # 月の軌道を計算 (楕円軌道で奥行きを表現)
    MX = CX + 120 * (RADのCOS)
    MY = CY + 30 * (RADのSIN)
    
    # 月が地球の裏側にある場合
    もし(RADのSIN) < 0 ならば
        極上月描画(MX, MY, 12)
    ここまで
    
    # 青が満ちあふれるリアル地球を描きます
    極上地球描画(CX, CY, ER)
    
    # 月が地球の手前にある場合
    もし(RADのSIN) >= 0 ならば
        極上月描画(MX, MY, 12)
    ここまで
ここまで。

●極上地球描画(X, Y, R)とは
    「rgba(0,0,0,0)」に線色設定
    
    「rgba(0, 120, 255, 0.12)」に塗色設定
    [X, Y]へ(R + 6)の円描画
    「rgba(0, 150, 255, 0.06)」に塗色設定
    [X, Y]へ(R + 12)の円描画
    
    # 50回のループで、青の面積が最大になるよう計算
    50回、
        もし、回数 <= 40 ならば
            # 1.【拡散反射エリア】
            K = 回数 / 40
            R_VAL = 0
            G_VAL = (60 + 110 * K)を整数変換
            B_VAL = (120 + 135 * K)を整数変換
            
            R_RATIO = 1.0 - (K * 0.65)
            OFFSET = 18 * K
        違えば
            # 2.【鏡面反射エリア】白いハイライト
            K = (回数 - 40) / 10
            K2 = K * K 
            R_VAL = (255 * K2)を整数変換
            G_VAL = (170 + 85 * K2)を整数変換
            B_VAL = 255
            
            R_RATIO = 0.35 - (K * 0.32)
            OFFSET = 18 + 6 * K
        ここまで
        
        CUR_R = R * R_RATIO
        CUR_X = X - OFFSET
        CUR_Y = Y - OFFSET
        
        もし、回数 <= 3 ならば
            ALPHA = 0.2 + (回数 / 3) * 0.8
            COLOR = 「rgba({R_VAL},{G_VAL},{B_VAL},{ALPHA})」
        違えば
            COLOR = 「rgb({R_VAL},{G_VAL},{B_VAL})」
        ここまで
        
        COLORに塗色設定
        [CUR_X, CUR_Y]へCUR_Rの円描画
    ここまで
ここまで。

●極上月描画(X, Y, R)とは
    「rgba(0,0,0,0)」に線色設定
    
    # 小さな月（半径12）に合わせて15回の高速・超高密度ループで描画します
    15回、
        もし、回数 <= 12 ならば
            # 1.【拡散反射エリア】
            K = 回数 / 12
            R_VAL = (90 + 165 * K)を整数変換
            G_VAL = (60 + 185 * K)を整数変換
            B_VAL = (10 + 40 * K)を整数変換
            
            R_RATIO = 1.0 - (K * 0.65)
            OFFSET = 3.6 * K
        違えば
            # 2.【鏡面反射エリア】
            K = (回数 - 12) / 3
            K2 = K * K
            R_VAL = 255
            G_VAL = 255
            B_VAL = (50 + 205 * K2)を整数変換
            
            R_RATIO = 0.35 - (K * 0.32)
            OFFSET = 3.6 + 1.2 * K
        ここまで
        
        CUR_R = R * R_RATIO
        CUR_X = X - OFFSET
        CUR_Y = Y - OFFSET
        
        もし、回数 <= 2 ならば
            ALPHA = 0.3 + (回数 / 2) * 0.7
            COLOR = 「rgba({R_VAL},{G_VAL},{B_VAL},{ALPHA})」
        違えば
            COLOR = 「rgb({R_VAL},{G_VAL},{B_VAL})」
        ここまで
        
        COLORに塗色設定
        [CUR_X, CUR_Y]へCUR_Rの円描画
    ここまで
ここまで。