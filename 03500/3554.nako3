# 「ContentView.swift」ファイルのコード
CONTENT_VIEW_SWIFT = r'''import SwiftUI
import WebKit

struct KioskWebView: UIViewRepresentable {
    func makeUIView(context: Context) -> WKWebView {
        let config = WKWebViewConfiguration()
        let webView = WKWebView(frame: .zero, configuration: config)
        webView.scrollView.bounces = false
        webView.scrollView.showsVerticalScrollIndicator = false
        webView.scrollView.showsHorizontalScrollIndicator = false
 
        // 初期ロード
        webView.load(URLRequest(url: URL(string: "http://localhost:8080")!))
        return webView
    }
    
    func updateUIView(_ uiView: WKWebView, context: Context) {}
}

struct ContentView: View {
    private let serverManager = LocalServerManager()

    init() {
        serverManager.startServer()
    }

    var body: some View {
        KioskWebView()
            .ignoresSafeArea() // ステータスバーなども隠す
    }
}'''

